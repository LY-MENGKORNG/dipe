{
  "name": "@repo/backend",
  "version": "0.0.1",
  "private": true,
  "description": "Introduction to NestJS data, integration and production essentials.",
  "author": "",
  "scripts": {
    "build": "bun --bun run nest build",
    "dev": "bun --env-file=../../.env --watch ./src/main.ts",
    "preview": "bun --bun run nest start --debug --watch",
    "start": "bun --bun run bun dist/main",
    "db:fmt": "bun --bun --env-file=../../.env run prisma format",
    "db:generate": "bun --bun --env-file=../../.env run prisma generate",
    "db:migrate:dev": "bun --bun --env-file=../../.env run prisma migrate dev",
    "db:migrate:status": "bun --bun --env-file=../../.env run prisma migrate status",
    "db:studio": "bun --bun --env-file=../../.env run prisma studio",
    "db:validate": "bun --bun --env-file=../../.env run prisma validate",
    "db:seed": "bun --env-file=../../.env ./src/config/db/seed.ts",
    "test": "bun --env-file=../../.env test",
    "test:unit": "bun --env-file=../../.env test ./src",
    "test:e2e": "bun --env-file=../../.env test ./test",
    "test:cov": "bun --env-file=../../.env test --coverage",
    "fmt": "bun --bun run oxfmt --write \"src/**/*.ts\"",
    "fmt:check": "bun --bun run oxfmt --check \"src/**/*.ts\"",
    "lint": "bun --bun run oxlint --type-aware src --fix",
    "lint:check": "bun --bun run oxlint --type-aware src"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/observe": "^0.3.10",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/platform-ws": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/env": "workspace:*",
    "@repo/http": "workspace:*",
    "@repo/utils": "workspace:*",
    "@scalar/nestjs-api-reference": "^1.2.29",
    "bullmq": "6.3.16",
    "fastify": "^5.12.7",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "mapped-types": "^0.0.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1"
  }
}

model Post {
  // fields
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  userId      Int      @map("user_id")

  // references
  poster User      @relation("post_poster", fields: [userId], references: [id])
  tags   PostTag[]

  // indexes/constrants
  @@index([userId])
  @@map("post")
}

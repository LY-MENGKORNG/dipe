model Post {
  // fields
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // references
  postId Int
  poster User @relation("post_poster", fields: [postId], references: [id])

  // indexes/constrants
  @@index([postId])

  @@map("post")
}

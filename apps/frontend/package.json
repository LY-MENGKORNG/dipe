{
  "name": "@repo/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun run vite",
    "build": "vue-tsc -b && bun --bun run vite build",
    "preview": "bun --bun run vite preview",
    "fmt": "bun --bun run oxfmt -c ./.oxfmtrc.json --write \"src/**/*.ts\"",
    "fmt:check": "bun --bun run oxfmt -c ./.oxfmtrc.json --check \"src/**/*.ts\"",
    "lint": "bun --bun run oxlint -c ./.oxlintrc.json --type-aware src --fix",
    "lint:check": "bun --bun run oxlint -c ./.oxlintrc.json --type-aware src"
  },
  "dependencies": {
    "@lucide/vue": "^1.59.0",
    "@repo/utils": "workspace:*",
    "@repo/http": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}

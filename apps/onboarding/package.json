{
  "name": "@repo/onboarding",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite dev",
    "build": "bun run --bun vite build",
    "preview": "bun --bun run vite preview",
    "start": "PORT=5174 bun ./build/index.js",
    "prepare": "bun --bun svelte-kit sync || echo ''",
    "check": "bun --bun svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun --bun svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@repo/http": "workspace:*",
    "@repo/env": "workspace:*",
    "@repo/utils": "workspace:*",
    "mode-watcher": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.62.0",
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/devtools": "^0.8.0",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.0",
    "shadcn-svelte": "^1.7.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}

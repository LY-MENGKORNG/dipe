{
  "ui": "tui",
  "$schema": "./node_modules/turbo/schema.json",
  "globalDependencies": [".env", ".env.*"],
  "tasks": {
    "dev": {
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist"],
      "persistent": true,
      "with": ["@repo/frontend#build", "@repo/backend#build"]
    },
    "start": {
      "dependsOn": ["^start"],
      "with": ["@repo/backend#start"]
    },
    "preview": {
      "dependsOn": ["^preview"]
    },
    "//#lint": {
      "cache": false
    },
    "//#test": {
      "cache": false
    },
    "//#lint:check": {},
    "//#fmt": {
      "cache": false
    },
    "//#fmt:check": {}
  }
}
